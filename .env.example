# 任何 OpenAI 兼容端点：内网网关 / vLLM / Ollama / 自建代理
OPENAI_API_KEY=your-key
BASE_URL=http://localhost:11434/v1
MODEL=qwen2.5:14b

# 可选：模型别名目录，别名=真实模型名，逗号分隔
# MODELS=fast=qwen2.5:7b,pro=qwen2.5:32b

# 可选：默认图表样式
# DIAGRAM_STYLE=architecture

# 可选：部分网关需要额外 version 头
# API_VERSION=v2

# 可选：自签证书网关设为 false（默认 false）
# SSL_VERIFY=false

# 可选：采样参数
# TEMPERATURE=0
# SEED=42

# 超时随环境：云端建议 120，本地大模型建议 600
# REQUEST_TIMEOUT=120
# 是否使用系统代理（默认 false）
# TRUST_ENV=false
# 可选显式代理
# PROXY=
